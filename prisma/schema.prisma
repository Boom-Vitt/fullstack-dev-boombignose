generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  manuals       Manual[]
  sessions      Session[]
  chatSessions  ChatSession[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Manual {
  id           String        @id @default(cuid())
  title        String
  description  String?       @db.Text
  fileKey      String?
  sourceUrl    String?
  mimeType     String?
  ragStoreName String        @unique
  documentName String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  chatSessions ChatSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("manuals")
}

model ChatSession {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  manual    Manual    @relation(fields: [manualId], references: [id], onDelete: Cascade)
  manualId  String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id            String       @id @default(cuid())
  chatSession   ChatSession  @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  chatSessionId String
  role          MessageRole
  content       String       @db.Text
  grounding     Json?
  createdAt     DateTime     @default(now())
}

enum MessageRole {
  USER
  ASSISTANT
}

